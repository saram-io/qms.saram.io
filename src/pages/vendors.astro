---
import Layout from '../layouts/Layout.astro';
import VendorDirectory from '../components/VendorDirectory.astro';
import { VENDORS } from '../data/vendors';
const vendorListSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "https://qms.saram.io/vendors#collection",
  "name": "Complete QMS Vendor Directory (2026)",
  "description": "Search and filter all tracked Quality Management Systems (QMS) across all 4 market tiers, deployment types, and AI capabilities.",
  "url": "https://qms.saram.io/vendors",
  "publisher": {
    "@type": "Organization",
    "name": "Saram Consulting",
    "url": "https://saram.io",
    "logo": {
      "@type": "ImageObject",
      "url": "https://qms.saram.io/logo.png"
    }
  },
  "mainEntity": {
    "@type": "ItemList",
    "name": "Tracked Life Sciences QMS Vendors",
    "numberOfItems": VENDORS.length,
    "itemListElement": VENDORS.map((v, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": `${v.name} - ${v.product}`,
      "description": v.summary,
      "url": v.website || `https://qms.saram.io/tiers#tier-${v.tier}`
    }))
  }
};

const breadcrumbs = [
  { name: 'Vendor Directory', path: '/vendors' }
];
---

<Layout 
  title="Complete QMS Vendor Directory (2026) | Saram Consulting"
  description="Search and filter all tracked Quality Management Systems (QMS) across all 4 market tiers, deployment types, and AI capabilities."
  activePath="/vendors"
  breadcrumbs={breadcrumbs}
  customSchema={vendorListSchema}
>
  <main>
    <section class="hero-text">
      <h1>Complete QMS Vendor Directory</h1>
      <p class="hero-subtitle">All {VENDORS.length} Tracked Quality Management Systems and Specialist Platforms</p>
      <p>
        Use the interactive controls below to search and filter across vendor names, product suites, market tiers, price transparency ratings (High, Moderate, Opaque), target buyers (e.g. <em>Big-pharma</em>, <em>Med device</em>, <em>CDMOs</em>), AI readiness ratings, and key differentiators.
      </p>
    </section>

    <section>
      <VendorDirectory />
    </section>
  </main>
</Layout>
