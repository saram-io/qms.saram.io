---
import { VENDORS } from '../data/vendors';
import VendorCard from './VendorCard.astro';

interface Props {
  initialTier?: number;
}

const { initialTier = 0 } = Astro.props;

const tier1Count = VENDORS.filter(v => v.tier === 1).length;
const tier2Count = VENDORS.filter(v => v.tier === 2).length;
const tier3Count = VENDORS.filter(v => v.tier === 3).length;
const tier4Count = VENDORS.filter(v => v.tier === 4).length;

const priceHighCount = VENDORS.filter(v => v.priceTransparency.startsWith('High')).length;
const priceModCount = VENDORS.filter(v => v.priceTransparency.startsWith('Moderate')).length;
const priceLowCount = VENDORS.filter(v => v.priceTransparency.startsWith('Low')).length;
---

<div class="vendor-directory-container">
  <div class="filter-bar">
    <input 
      type="text" 
      id="vendorSearchInput" 
      class="search-input" 
      aria-label="Search QMS vendors by name, category, buyer, or price transparency"
      placeholder="Search by vendor name, category, buyer (e.g. Med device, Big-pharma), price model, or AI milestone..." 
    />
    
    <div class="filter-pills">
      <span class="filter-pill-label">Tier:</span>
      <button class={`filter-btn ${initialTier === 0 ? 'active' : ''}`} data-filter-tier="all">All Tiers ({VENDORS.length})</button>
      <button class={`filter-btn ${initialTier === 1 ? 'active' : ''}`} data-filter-tier="1">Tier 1: Platforms ({tier1Count})</button>
      <button class={`filter-btn ${initialTier === 2 ? 'active' : ''}`} data-filter-tier="2">Tier 2: Pure-Play ({tier2Count})</button>
      <button class={`filter-btn ${initialTier === 3 ? 'active' : ''}`} data-filter-tier="3">Tier 3: Specialists ({tier3Count})</button>
      <button class={`filter-btn ${initialTier === 4 ? 'active' : ''}`} data-filter-tier="4">Tier 4: Disruptors ({tier4Count})</button>
    </div>

    <div class="filter-pills" style="margin-top: 8px;">
      <span class="filter-pill-label">Price Transparency:</span>
      <button class="filter-btn active" data-filter-price="all">All ({VENDORS.length})</button>
      <button class="filter-btn" data-filter-price="high">High / Transparent ({priceHighCount})</button>
      <button class="filter-btn" data-filter-price="moderate">Moderate ({priceModCount})</button>
      <button class="filter-btn" data-filter-price="low">Low / Opaque ({priceLowCount})</button>
    </div>

    <div style="font-size: 11.5px; color: var(--muted-text); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-top: 8px;">
      <span id="resultsCount">Showing {VENDORS.length} of {VENDORS.length} vendors</span>
      <span id="activeFiltersDisplay">Active: All Tiers | All Price Ratings</span>
    </div>
  </div>

  <div class="cards-grid" id="vendorCardsGrid">
    {VENDORS.map(vendor => (
      <VendorCard vendor={vendor} />
    ))}
  </div>

  <div id="noResultsMessage" style="display: none; padding: 40px; text-align: center; background: var(--card-bg); border-radius: 6px; border: 1px dashed #999;">
    <h3 style="font-family: var(--font-serif); margin-bottom: 8px;">No matching vendors found</h3>
    <p style="font-size: 13px; color: var(--muted-text);">Try clearing your search query or selecting a different tier or price filter.</p>
    <button class="filter-btn" id="resetFiltersBtn" style="margin-top: 12px; background: #000; color: #fff;">Reset Filters</button>
  </div>
</div>

<script is:inline>
  (function() {
    function initVendorDirectory() {
      const searchInput = document.getElementById('vendorSearchInput');
      const tierBtns = document.querySelectorAll('[data-filter-tier]');
      const priceBtns = document.querySelectorAll('[data-filter-price]');
      const cards = document.querySelectorAll('#vendorCardsGrid .card');
      const resultsCount = document.getElementById('resultsCount');
      const activeFiltersDisplay = document.getElementById('activeFiltersDisplay');
      const noResultsMsg = document.getElementById('noResultsMessage');
      const resetBtn = document.getElementById('resetFiltersBtn');

      if (!searchInput || !cards.length) return;

      const activeTierBtn = document.querySelector('[data-filter-tier].active');
      let currentTier = activeTierBtn ? (activeTierBtn.getAttribute('data-filter-tier') || 'all') : 'all';
      let currentPrice = 'all';
      let currentQuery = '';

      function filterCards() {
        let visibleCount = 0;
        const total = cards.length;

        cards.forEach(card => {
          const tier = card.getAttribute('data-tier');
          const price = card.getAttribute('data-price');
          const searchContent = card.getAttribute('data-search') || '';

          const matchesTier = (currentTier === 'all' || tier === currentTier);
          const matchesPrice = (currentPrice === 'all' || price === currentPrice);
          const matchesQuery = !currentQuery || searchContent.includes(currentQuery.toLowerCase());

          if (matchesTier && matchesPrice && matchesQuery) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (resultsCount) {
          resultsCount.textContent = `Showing ${visibleCount} of ${total} vendors`;
        }

        if (activeFiltersDisplay) {
          const tierNames = {
            all: 'All Tiers',
            '1': 'Tier 1: Platforms',
            '2': 'Tier 2: Pure-Play',
            '3': 'Tier 3: Specialists',
            '4': 'Tier 4: Disruptors'
          };
          const priceNames = {
            all: 'All Price Ratings',
            high: 'High (Transparent)',
            moderate: 'Moderate (Directional)',
            low: 'Low (Opaque)'
          };
          const tierText = tierNames[currentTier] || `Tier ${currentTier}`;
          const priceText = priceNames[currentPrice] || currentPrice;
          const queryText = currentQuery ? ` "${currentQuery}"` : '';
          activeFiltersDisplay.textContent = `Active: ${tierText} | ${priceText}${queryText}`;
        }

        if (noResultsMsg) {
          noResultsMsg.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      }

      tierBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          tierBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          currentTier = btn.getAttribute('data-filter-tier') || 'all';
          filterCards();
        });
      });

      priceBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          priceBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          currentPrice = btn.getAttribute('data-filter-price') || 'all';
          filterCards();
        });
      });

      searchInput.addEventListener('input', (e) => {
        currentQuery = e.target.value.trim();
        filterCards();
      });

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          searchInput.value = '';
          currentQuery = '';
          currentTier = 'all';
          currentPrice = 'all';
          tierBtns.forEach(b => {
            b.classList.toggle('active', b.getAttribute('data-filter-tier') === 'all');
          });
          priceBtns.forEach(b => {
            b.classList.toggle('active', b.getAttribute('data-filter-price') === 'all');
          });
          filterCards();
        });
      }

      // Initial filter if loaded with initialTier
      if (currentTier !== 'all') {
        filterCards();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initVendorDirectory);
    } else {
      initVendorDirectory();
    }
  })();
</script>
