---
import { AI_READINESS_DATA, getTrackerStats } from '../data/aiReadinessTracker';

const stats = getTrackerStats();
---

<div class="ai-tracker-wrapper">
  <!-- Top Stat Cards -->
  <div class="tracker-kpi-grid">
    <div class="kpi-card">
      <div class="kpi-label">Tracked QMS Vendors</div>
      <div class="kpi-value">{stats.total}</div>
      <div class="kpi-sub">Audited across Tiers 1–4</div>
    </div>
    
    <div class="kpi-card kpi-success">
      <div class="kpi-label">Open Ecosystems</div>
      <div class="kpi-value">{stats.openPct}%</div>
      <div class="kpi-sub">{stats.openCount} of {stats.total} vendors</div>
    </div>

    <div class="kpi-card kpi-accent">
      <div class="kpi-label">MCP Server Ready</div>
      <div class="kpi-value">{stats.mcpShippedPct}%</div>
      <div class="kpi-sub">{stats.mcpShippedCount} vendors GA or in Beta</div>
    </div>

    <div class="kpi-card kpi-warning">
      <div class="kpi-label">Proprietary Silos</div>
      <div class="kpi-value">{stats.proprietarySiloPct}%</div>
      <div class="kpi-sub">{stats.proprietarySiloCount} locked walled gardens</div>
    </div>

    <div class="kpi-card">
      <div class="kpi-label">Avg Openness Index</div>
      <div class="kpi-value">{stats.avgScore}<span style="font-size: 14px; font-weight: normal; color: var(--muted-text);">/100</span></div>
      <div class="kpi-sub">Composite open-readiness</div>
    </div>
  </div>

  <!-- Filter & Controls Toolbar -->
  <div class="tracker-toolbar">
    <div class="search-row">
      <input 
        type="text" 
        id="trackerSearchInput" 
        class="search-input" 
        placeholder="Filter by vendor, protocol (MCP, REST, GraphQL), BYO-AI stance, or lock-in risk..." 
      />
      <div class="view-switchers">
        <button class="view-btn active" id="viewMatrixBtn" title="Comparison Matrix View">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h18v18H3zM3 9h18M3 15h18M9 3v18M15 3v18"/></svg>
          Matrix View
        </button>
        <button class="view-btn" id="viewCardsBtn" title="Detailed Dossier Cards View">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
          Dossier View
        </button>
      </div>
    </div>

    <!-- Filter Pills Row 1: Walled Garden Stance -->
    <div class="filter-group-row">
      <span class="group-label">Walled Garden Stance:</span>
      <div class="pill-group" id="walledGardenFilters">
        <button class="filter-pill active" data-filter-garden="all">All ({AI_READINESS_DATA.length})</button>
        <button class="filter-pill" data-filter-garden="Open Ecosystem">Open Ecosystem ({AI_READINESS_DATA.filter(v => v.walledGardenStatus === 'Open Ecosystem').length})</button>
        <button class="filter-pill" data-filter-garden="Selective / Conditional">Selective / Conditional ({AI_READINESS_DATA.filter(v => v.walledGardenStatus === 'Selective / Conditional').length})</button>
        <button class="filter-pill" data-filter-garden="Proprietary Silo">Proprietary Silo ({AI_READINESS_DATA.filter(v => v.walledGardenStatus === 'Proprietary Silo').length})</button>
        <button class="filter-pill" data-filter-garden="Legacy Walled Garden">Legacy Walled Garden ({AI_READINESS_DATA.filter(v => v.walledGardenStatus === 'Legacy Walled Garden').length})</button>
      </div>
    </div>

    <!-- Filter Pills Row 2: MCP Status & Sorting -->
    <div class="filter-group-row" style="margin-top: 8px;">
      <span class="group-label">Model Context Protocol (MCP):</span>
      <div class="pill-group" id="mcpFilters">
        <button class="filter-pill active" data-filter-mcp="all">All</button>
        <button class="filter-pill" data-filter-mcp="GA (Shipped)">GA (Shipped)</button>
        <button class="filter-pill" data-filter-mcp="In Beta / Preview">Beta / Preview</button>
        <button class="filter-pill" data-filter-mcp="Roadmap / Announced">Roadmap</button>
        <button class="filter-pill" data-filter-mcp="None / Refusal">None / Refusal</button>
      </div>

      <div class="sort-wrapper">
        <label for="trackerSortSelect" class="sort-label">Sort:</label>
        <select id="trackerSortSelect" class="sort-select">
          <option value="score-desc">Openness Score (High to Low)</option>
          <option value="score-asc">Openness Score (Low to High)</option>
          <option value="name-asc">Vendor Name (A-Z)</option>
          <option value="tier-asc">Market Tier (1 to 4)</option>
        </select>
      </div>
    </div>

    <div class="results-meta-bar">
      <span id="trackerResultsCounter">Showing {AI_READINESS_DATA.length} of {AI_READINESS_DATA.length} evaluated vendors</span>
      <span id="trackerFilterStatus">Active: All vendors</span>
    </div>
  </div>

  <!-- VIEW 1: MATRIX TABLE VIEW -->
  <div id="trackerMatrixView" class="tracker-view-container">
    <div class="table-wrapper">
      <table class="tracker-matrix-table">
        <thead>
          <tr>
            <th style="min-width: 170px;">Vendor & Product</th>
            <th style="min-width: 130px;">Walled Garden Stance</th>
            <th style="min-width: 110px;">Open Score</th>
            <th style="min-width: 140px;">MCP Server</th>
            <th style="min-width: 150px;">API & Webhooks</th>
            <th style="min-width: 130px;">BYO-AI Model</th>
            <th style="min-width: 120px;">ISO 42001</th>
            <th style="min-width: 140px;">Part 11 AI Audit</th>
            <th style="min-width: 110px;">Lock-in Risk</th>
          </tr>
        </thead>
        <tbody id="trackerTableBody">
          {AI_READINESS_DATA.map((v) => {
            const gardenClass = 
              v.walledGardenStatus === 'Open Ecosystem' ? 'badge-open' :
              v.walledGardenStatus === 'Selective / Conditional' ? 'badge-selective' :
              v.walledGardenStatus === 'Proprietary Silo' ? 'badge-silo' : 'badge-legacy';

            const mcpClass = 
              v.mcpStatus === 'GA (Shipped)' ? 'badge-mcp-ga' :
              v.mcpStatus === 'In Beta / Preview' ? 'badge-mcp-beta' :
              v.mcpStatus === 'Roadmap / Announced' ? 'badge-mcp-roadmap' : 'badge-mcp-none';

            const scoreColor = 
              v.openReadinessScore >= 80 ? '#1b5e20' :
              v.openReadinessScore >= 65 ? '#2e7d32' :
              v.openReadinessScore >= 50 ? '#b26a00' : '#c62828';

            const moatColor = 
              v.commercialMoatRisk.startsWith('Low') ? '#1b5e20' :
              v.commercialMoatRisk.startsWith('Medium') ? '#b26a00' : '#c62828';

            return (
              <tr 
                class="tracker-row" 
                data-id={v.id}
                data-tier={v.tier}
                data-score={v.openReadinessScore}
                data-name={v.vendorName.toLowerCase()}
                data-garden={v.walledGardenStatus}
                data-mcp={v.mcpStatus}
                data-search={`${v.vendorName} ${v.productName} ${v.category} ${v.mcpDetails} ${v.apiDetails} ${v.verdictSummary} ${v.byoAiPolicy}`.toLowerCase()}
              >
                <td>
                  <strong class="vendor-title-link">
                    {v.website ? (
                      <a href={v.website} target="_blank" rel="noopener">{v.vendorName}</a>
                    ) : (
                      <span>{v.vendorName}</span>
                    )}
                  </strong>
                  {v.ticker && <span class="vendor-ticker">{v.ticker}</span>}
                  <div class="product-subtitle">{v.productName}</div>
                  <span class="tier-tag">Tier {v.tier}</span>
                </td>
                <td>
                  <span class={`status-badge ${gardenClass}`}>{v.walledGardenStatus}</span>
                  <div class="pricing-posture">{v.apiPricingPosture}</div>
                </td>
                <td>
                  <div class="score-display">
                    <span class="score-num" style={`color: ${scoreColor};`}>{v.openReadinessScore}</span>
                    <div class="score-bar-track">
                      <div class="score-bar-fill" style={`width: ${v.openReadinessScore}%; background: ${scoreColor};`}></div>
                    </div>
                  </div>
                </td>
                <td>
                  <span class={`status-badge ${mcpClass}`}>{v.mcpStatus}</span>
                  <p class="matrix-cell-note">{v.mcpDetails}</p>
                </td>
                <td>
                  <strong style="font-size: 11.5px; display: block;">{v.apiGrade.split(' ')[0]} {v.apiGrade.split(' ')[1]}</strong>
                  <span style="font-size: 11px; color: var(--muted-text); display: block;">
                    Webhooks: {v.webhooksSupported ? '✓ Supported' : '✗ None'}
                  </span>
                  <p class="matrix-cell-note">{v.apiDetails}</p>
                </td>
                <td>
                  <span class="text-pill">{v.byoAiPolicy}</span>
                </td>
                <td>
                  <span style="font-size: 11.5px; font-weight: 500;">{v.iso42001Status}</span>
                </td>
                <td>
                  <span style="font-size: 11.5px;">{v.part11AuditTrailDefensibility}</span>
                </td>
                <td>
                  <span class="moat-risk-tag" style={`color: ${moatColor}; border-color: ${moatColor}44;`}>
                    {v.commercialMoatRisk}
                  </span>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>

  <!-- VIEW 2: DETAILED DOSSIER CARDS VIEW -->
  <div id="trackerCardsView" class="tracker-view-container" style="display: none;">
    <div class="cards-grid" id="trackerCardsGrid">
      {AI_READINESS_DATA.map((v) => {
        const gardenClass = 
          v.walledGardenStatus === 'Open Ecosystem' ? 'badge-open' :
          v.walledGardenStatus === 'Selective / Conditional' ? 'badge-selective' :
          v.walledGardenStatus === 'Proprietary Silo' ? 'badge-silo' : 'badge-legacy';

        const mcpClass = 
          v.mcpStatus === 'GA (Shipped)' ? 'badge-mcp-ga' :
          v.mcpStatus === 'In Beta / Preview' ? 'badge-mcp-beta' :
          v.mcpStatus === 'Roadmap / Announced' ? 'badge-mcp-roadmap' : 'badge-mcp-none';

        const scoreColor = 
          v.openReadinessScore >= 80 ? '#1b5e20' :
          v.openReadinessScore >= 65 ? '#2e7d32' :
          v.openReadinessScore >= 50 ? '#b26a00' : '#c62828';

        return (
          <div 
            class="card tracker-dossier-card"
            data-id={v.id}
            data-tier={v.tier}
            data-score={v.openReadinessScore}
            data-name={v.vendorName.toLowerCase()}
            data-garden={v.walledGardenStatus}
            data-mcp={v.mcpStatus}
            data-search={`${v.vendorName} ${v.productName} ${v.category} ${v.mcpDetails} ${v.apiDetails} ${v.verdictSummary} ${v.byoAiPolicy}`.toLowerCase()}
          >
            <div class="card-top-row">
              <div>
                <div class="card-tier-label">{v.tierLabel}</div>
                <h3 class="vendor-name-header">
                  {v.website ? (
                    <a href={v.website} target="_blank" rel="noopener">{v.vendorName}</a>
                  ) : (
                    <span>{v.vendorName}</span>
                  )}
                  {v.ticker && <span class="vendor-ticker">{v.ticker}</span>}
                </h3>
                <div class="card-product-name">{v.productName}</div>
              </div>
              <div class="card-score-badge" style={`border-color: ${scoreColor};`}>
                <span class="score-badge-val" style={`color: ${scoreColor};`}>{v.openReadinessScore}</span>
                <span class="score-badge-label">OPEN SCORE</span>
              </div>
            </div>

            <!-- Stance and MCP Badges -->
            <div class="badges-strip">
              <span class={`status-badge ${gardenClass}`}>{v.walledGardenStatus}</span>
              <span class={`status-badge ${mcpClass}`}>MCP: {v.mcpStatus}</span>
              <span class="status-badge" style="background: #ffffff; border: 1px solid #00000022; color: #222;">{v.byoAiPolicy}</span>
            </div>

            <!-- Saram Independent Verdict -->
            <div class="verdict-box">
              <strong class="verdict-title">Saram Independent Verdict & Data Stance:</strong>
              <p class="verdict-text">{v.verdictSummary}</p>
            </div>

            <!-- Technical Specifications Grid -->
            <div class="tech-spec-grid">
              <div class="spec-cell">
                <span class="spec-label">Model Context Protocol (MCP)</span>
                <p class="spec-val">{v.mcpDetails}</p>
              </div>

              <div class="spec-cell">
                <span class="spec-label">API Infrastructure & Webhooks</span>
                <p class="spec-val">
                  <strong>{v.apiGrade}</strong><br />
                  Webhooks: {v.webhooksSupported ? '✓ Real-time Supported' : '✗ Not Supported / Polling'}<br />
                  {v.apiDetails}
                </p>
              </div>

              <div class="spec-cell">
                <span class="spec-label">AI Trust & 21 CFR Part 11 Audit Defensibility</span>
                <p class="spec-val">
                  <strong>ISO 42001:</strong> {v.iso42001Status}<br />
                  <strong>Audit Trail:</strong> {v.part11AuditTrailDefensibility}
                </p>
              </div>

              <div class="spec-cell">
                <span class="spec-label">Commercial Moat & API Pricing</span>
                <p class="spec-val">
                  <strong>Lock-in Risk:</strong> {v.commercialMoatRisk}<br />
                  <strong>API Pricing:</strong> {v.apiPricingPosture}
                </p>
              </div>
            </div>

            <div class="card-footer-audit">
              <span>Audited: {v.lastAudited}</span>
              {v.website && (
                <a href={v.website} target="_blank" rel="noopener" class="external-link">
                  Vendor Official Site →
                </a>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Empty state -->
  <div id="trackerEmptyState" style="display: none; padding: 40px; text-align: center; background: var(--card-bg); border-radius: 6px; border: 1px dashed #999; margin-top: 20px;">
    <h3 style="font-family: var(--font-serif); margin-bottom: 8px;">No vendors matched your filter criteria</h3>
    <p style="font-size: 13px; color: var(--muted-text);">Try adjusting your search terms or clearing the Walled Garden or MCP filters.</p>
    <button class="filter-pill" id="trackerResetBtn" style="margin-top: 14px; background: #000; color: #fff; border-color: #000;">Reset All Filters</button>
  </div>
</div>

<style>
  .ai-tracker-wrapper {
    margin: 20px 0 40px 0;
  }

  /* KPI Grid */
  .tracker-kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 14px;
    margin-bottom: 24px;
  }

  .kpi-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 6px;
    padding: 14px 16px;
  }

  .kpi-label {
    font-size: 11px;
    color: var(--muted-text);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
  }

  .kpi-value {
    font-family: var(--font-serif);
    font-size: 26px;
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 2px;
  }

  .kpi-sub {
    font-size: 11px;
    color: var(--muted-text);
  }

  .kpi-success .kpi-value {
    color: #1b5e20;
  }

  .kpi-accent .kpi-value {
    color: #0d47a1;
  }

  .kpi-warning .kpi-value {
    color: #b71c1c;
  }

  /* Toolbar */
  .tracker-toolbar {
    background: #fdfdfc;
    border: 1px solid var(--card-border);
    border-radius: 6px;
    padding: 16px;
    margin-bottom: 20px;
  }

  .search-row {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .search-row .search-input {
    flex: 1;
    min-width: 260px;
    padding: 10px 14px;
    font-family: var(--font-mono);
    font-size: 13px;
    border: 1px solid #00000026;
    border-radius: 4px;
    background: #fff;
    outline: none;
  }

  .search-row .search-input:focus {
    border-color: #000;
  }

  .view-switchers {
    display: flex;
    gap: 6px;
  }

  .view-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    border: 1px solid #00000022;
    background: #fff;
    cursor: pointer;
    border-radius: 4px;
    color: var(--text-color);
  }

  .view-btn.active {
    background: #000;
    color: #fff;
    border-color: #000;
  }

  .filter-group-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .group-label {
    font-size: 11.5px;
    color: var(--muted-text);
    font-weight: 500;
    min-width: 170px;
  }

  .pill-group {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    flex: 1;
  }

  .filter-pill {
    font-family: var(--font-mono);
    font-size: 11.5px;
    padding: 4px 10px;
    background: #fff;
    border: 1px solid #00000022;
    border-radius: 20px;
    cursor: pointer;
    color: var(--text-color);
    transition: all 0.15s ease;
  }

  .filter-pill:hover {
    border-color: #00000066;
  }

  .filter-pill.active {
    background: #000;
    color: #fff;
    border-color: #000;
  }

  .sort-wrapper {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }

  .sort-label {
    font-size: 11.5px;
    color: var(--muted-text);
  }

  .sort-select {
    font-family: var(--font-mono);
    font-size: 11.5px;
    padding: 4px 8px;
    border: 1px solid #00000026;
    border-radius: 4px;
    background: #fff;
    cursor: pointer;
  }

  .results-meta-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid #00000010;
    font-size: 11.5px;
    color: var(--muted-text);
  }

  /* Status Badges */
  .status-badge {
    display: inline-block;
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  .badge-open {
    background: #e8f5e9;
    color: #1b5e20;
    border: 1px solid #c8e6c9;
  }

  .badge-selective {
    background: #fff8e1;
    color: #b26a00;
    border: 1px solid #ffe082;
  }

  .badge-silo {
    background: #fbe9e7;
    color: #c62828;
    border: 1px solid #ffcdd2;
  }

  .badge-legacy {
    background: #efebe9;
    color: #4e342e;
    border: 1px solid #d7ccc8;
  }

  .badge-mcp-ga {
    background: #e3f2fd;
    color: #0d47a1;
    border: 1px solid #bbdefb;
  }

  .badge-mcp-beta {
    background: #ede7f6;
    color: #4a148c;
    border: 1px solid #d1c4e9;
  }

  .badge-mcp-roadmap {
    background: #f5f5f5;
    color: #424242;
    border: 1px solid #e0e0e0;
  }

  .badge-mcp-none {
    background: #fafafa;
    color: #757575;
    border: 1px solid #eeeeee;
  }

  /* Matrix Table Styling */
  .tracker-matrix-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12.5px;
    text-align: left;
  }

  .tracker-matrix-table th {
    background: #00000008;
    padding: 10px 12px;
    font-size: 11.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 2px solid #00000022;
  }

  .tracker-matrix-table td {
    padding: 14px 12px;
    border-bottom: 1px solid #00000014;
    vertical-align: top;
  }

  .tracker-matrix-table tr:hover {
    background: #00000004;
  }

  .vendor-title-link {
    font-family: var(--font-serif);
    font-size: 14.5px;
    display: inline-block;
  }

  .vendor-title-link a {
    color: #000;
    text-decoration: underline 1px;
    text-decoration-color: var(--underline-color);
  }

  .vendor-ticker {
    font-size: 10.5px;
    color: var(--muted-text);
    margin-left: 6px;
    font-weight: normal;
  }

  .product-subtitle {
    font-size: 11.5px;
    color: #444;
    margin-top: 3px;
    line-height: 1.35;
  }

  .tier-tag {
    display: inline-block;
    font-size: 10.5px;
    background: var(--card-bg);
    padding: 1px 6px;
    border-radius: 3px;
    border: 1px solid var(--card-border);
    margin-top: 4px;
  }

  .pricing-posture {
    font-size: 11px;
    color: var(--muted-text);
    margin-top: 4px;
  }

  .score-display {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .score-num {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 700;
  }

  .score-bar-track {
    width: 70px;
    height: 5px;
    background: #00000014;
    border-radius: 3px;
    overflow: hidden;
  }

  .score-bar-fill {
    height: 100%;
    border-radius: 3px;
  }

  .matrix-cell-note {
    font-size: 11px;
    color: var(--muted-text);
    line-height: 1.4;
    margin-top: 4px;
    max-width: 240px;
  }

  .text-pill {
    font-size: 11px;
    background: #f0efe8;
    padding: 2px 6px;
    border-radius: 3px;
    border: 1px solid #00000014;
    display: inline-block;
  }

  .moat-risk-tag {
    font-size: 11px;
    font-weight: 600;
    padding: 2px 6px;
    border: 1px solid;
    border-radius: 3px;
    display: inline-block;
  }

  /* Dossier Cards Styling */
  .tracker-dossier-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .card-top-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
  }

  .card-tier-label {
    font-size: 11px;
    color: var(--muted-text);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 2px;
  }

  .vendor-name-header {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
  }

  .vendor-name-header a {
    color: #000;
    text-decoration: underline 1px;
    text-decoration-color: var(--underline-color);
  }

  .card-product-name {
    font-size: 12.5px;
    color: #333;
    margin-top: 2px;
  }

  .card-score-badge {
    border: 2px solid;
    border-radius: 6px;
    padding: 6px 10px;
    text-align: center;
    background: #fff;
    min-width: 70px;
  }

  .score-badge-val {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 700;
    display: block;
    line-height: 1;
  }

  .score-badge-label {
    font-size: 9px;
    color: var(--muted-text);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .badges-strip {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
  }

  .verdict-box {
    background: #ffffff88;
    border: 1px solid #00000014;
    border-left: 3px solid #000;
    padding: 10px 12px;
    border-radius: 4px;
    font-size: 12.5px;
  }

  .verdict-title {
    display: block;
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    margin-bottom: 4px;
    color: #111;
  }

  .verdict-text {
    line-height: 1.5;
    color: #222;
    margin-bottom: 0;
  }

  .tech-spec-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 10px;
    font-size: 12px;
  }

  .spec-cell {
    background: #fdfdfc;
    border: 1px solid #00000010;
    border-radius: 4px;
    padding: 8px 10px;
  }

  .spec-label {
    font-size: 10.5px;
    color: var(--muted-text);
    text-transform: uppercase;
    letter-spacing: 0.4px;
    display: block;
    margin-bottom: 4px;
    font-weight: 600;
  }

  .spec-val {
    line-height: 1.45;
    color: #222;
    margin-bottom: 0;
  }

  .card-footer-audit {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    color: var(--muted-text);
    border-top: 1px solid #00000010;
    padding-top: 8px;
    margin-top: 4px;
  }

  .external-link {
    color: #000;
    text-decoration: underline 1px;
    text-decoration-color: var(--underline-color);
  }
</style>

<script is:inline>
  (function() {
    function initAiTracker() {
      const searchInput = document.getElementById('trackerSearchInput');
      const gardenBtns = document.querySelectorAll('#walledGardenFilters .filter-pill');
      const mcpBtns = document.querySelectorAll('#mcpFilters .filter-pill');
      const sortSelect = document.getElementById('trackerSortSelect');
      const viewMatrixBtn = document.getElementById('viewMatrixBtn');
      const viewCardsBtn = document.getElementById('viewCardsBtn');
      const matrixView = document.getElementById('trackerMatrixView');
      const cardsView = document.getElementById('trackerCardsView');
      const resultsCounter = document.getElementById('trackerResultsCounter');
      const filterStatus = document.getElementById('trackerFilterStatus');
      const emptyState = document.getElementById('trackerEmptyState');
      const resetBtn = document.getElementById('trackerResetBtn');

      const rows = Array.from(document.querySelectorAll('#trackerTableBody tr'));
      const cards = Array.from(document.querySelectorAll('#trackerCardsGrid .card'));

      if (!searchInput || !rows.length) return;

      let currentGarden = 'all';
      let currentMcp = 'all';
      let currentQuery = '';
      let currentSort = 'score-desc';

      // View switcher
      viewMatrixBtn.addEventListener('click', () => {
        viewMatrixBtn.classList.add('active');
        viewCardsBtn.classList.remove('active');
        matrixView.style.display = 'block';
        cardsView.style.display = 'none';
      });

      viewCardsBtn.addEventListener('click', () => {
        viewCardsBtn.classList.add('active');
        viewMatrixBtn.classList.remove('active');
        matrixView.style.display = 'none';
        cardsView.style.display = 'block';
      });

      // Filter handling
      gardenBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          gardenBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          currentGarden = btn.getAttribute('data-filter-garden') || 'all';
          applyFiltersAndSort();
        });
      });

      mcpBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          mcpBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          currentMcp = btn.getAttribute('data-filter-mcp') || 'all';
          applyFiltersAndSort();
        });
      });

      searchInput.addEventListener('input', (e) => {
        currentQuery = e.target.value.trim().toLowerCase();
        applyFiltersAndSort();
      });

      sortSelect.addEventListener('change', (e) => {
        currentSort = e.target.value;
        applyFiltersAndSort();
      });

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          searchInput.value = '';
          currentQuery = '';
          currentGarden = 'all';
          currentMcp = 'all';
          currentSort = 'score-desc';
          sortSelect.value = 'score-desc';

          gardenBtns.forEach(b => b.classList.toggle('active', b.getAttribute('data-filter-garden') === 'all'));
          mcpBtns.forEach(b => b.classList.toggle('active', b.getAttribute('data-filter-mcp') === 'all'));
          applyFiltersAndSort();
        });
      }

      function compareElements(a, b) {
        if (currentSort === 'score-desc') {
          return parseInt(b.getAttribute('data-score') || '0', 10) - parseInt(a.getAttribute('data-score') || '0', 10);
        } else if (currentSort === 'score-asc') {
          return parseInt(a.getAttribute('data-score') || '0', 10) - parseInt(b.getAttribute('data-score') || '0', 10);
        } else if (currentSort === 'name-asc') {
          return (a.getAttribute('data-name') || '').localeCompare(b.getAttribute('data-name') || '');
        } else if (currentSort === 'tier-asc') {
          return parseInt(a.getAttribute('data-tier') || '99', 10) - parseInt(b.getAttribute('data-tier') || '99', 10);
        }
        return 0;
      }

      function applyFiltersAndSort() {
        let visibleCount = 0;
        const total = rows.length;

        // Filter and re-sort rows
        rows.sort(compareElements);
        const tableBody = document.getElementById('trackerTableBody');
        rows.forEach(row => {
          tableBody.appendChild(row);

          const garden = row.getAttribute('data-garden');
          const mcp = row.getAttribute('data-mcp');
          const searchData = row.getAttribute('data-search') || '';

          const matchGarden = (currentGarden === 'all' || garden === currentGarden);
          const matchMcp = (currentMcp === 'all' || mcp === currentMcp);
          const matchQuery = !currentQuery || searchData.includes(currentQuery);

          if (matchGarden && matchMcp && matchQuery) {
            row.style.display = '';
            visibleCount++;
          } else {
            row.style.display = 'none';
          }
        });

        // Filter and re-sort cards
        cards.sort(compareElements);
        const cardsGrid = document.getElementById('trackerCardsGrid');
        cards.forEach(card => {
          cardsGrid.appendChild(card);

          const garden = card.getAttribute('data-garden');
          const mcp = card.getAttribute('data-mcp');
          const searchData = card.getAttribute('data-search') || '';

          const matchGarden = (currentGarden === 'all' || garden === currentGarden);
          const matchMcp = (currentMcp === 'all' || mcp === currentMcp);
          const matchQuery = !currentQuery || searchData.includes(currentQuery);

          if (matchGarden && matchMcp && matchQuery) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });

        // Update counter & labels
        if (resultsCounter) {
          resultsCounter.textContent = `Showing ${visibleCount} of ${total} evaluated vendors`;
        }

        if (filterStatus) {
          const parts = [];
          if (currentGarden !== 'all') parts.push(`Stance: ${currentGarden}`);
          if (currentMcp !== 'all') parts.push(`MCP: ${currentMcp}`);
          if (currentQuery) parts.push(`Search: "${currentQuery}"`);
          filterStatus.textContent = parts.length ? `Active: ${parts.join(' | ')}` : 'Active: All vendors';
        }

        // Toggle empty state
        if (emptyState) {
          if (visibleCount === 0) {
            emptyState.style.display = 'block';
            matrixView.style.display = 'none';
            cardsView.style.display = 'none';
          } else {
            emptyState.style.display = 'none';
            if (viewMatrixBtn.classList.contains('active')) {
              matrixView.style.display = 'block';
              cardsView.style.display = 'none';
            } else {
              matrixView.style.display = 'none';
              cardsView.style.display = 'block';
            }
          }
        }
      }

      // Initial run
      applyFiltersAndSort();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAiTracker);
    } else {
      initAiTracker();
    }
  })();
</script>
