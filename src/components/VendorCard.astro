---
import type { Vendor } from '../data/vendors';

interface Props {
  vendor: Vendor;
}

const { vendor } = Astro.props;

const tierBadgeClass = 
  vendor.tier === 1 ? 'badge-tier1' :
  vendor.tier === 2 ? 'badge-tier2' :
  vendor.tier === 3 ? 'badge-tier3' : 'badge-tier4';

const searchTokens = [
  vendor.name,
  vendor.product,
  vendor.category,
  vendor.summary,
  vendor.aiMilestones || '',
  vendor.keyDifferentiator,
  vendor.targetBuyers.join(' '),
  vendor.scope?.join(' ') || ''
].join(' ').toLowerCase();
---

<div 
  class="card" 
  data-tier={vendor.tier} 
  data-category={vendor.category} 
  data-name={vendor.name.toLowerCase()} 
  data-search={searchTokens}
>
  <div class="card-header">
    <div>
      <h3 class="card-title">{vendor.name}</h3>
      <div class="card-subtitle">{vendor.product}</div>
    </div>
    <span class={`badge ${tierBadgeClass}`}>{vendor.tier === 1 ? 'Tier 1' : vendor.tier === 2 ? 'Tier 2' : vendor.tier === 3 ? 'Tier 3' : 'Tier 4'}</span>
  </div>

  <div class="card-body">
    <p>{vendor.summary}</p>
    
    <div style="margin: 8px 0; display: flex; flex-wrap: wrap; gap: 4px;">
      <span class="badge">{vendor.category}</span>
      {vendor.aiReadiness && (
        <span class="badge badge-ai">AI: {vendor.aiReadiness}</span>
      )}
    </div>

    {vendor.aiMilestones && (
      <div style="font-size: 11.5px; background: rgba(0,0,0,0.03); padding: 8px 10px; border-radius: 4px; margin: 8px 0; border-left: 2px solid #333; line-height: 1.45;">
        <strong>2026 AI Status:</strong> {vendor.aiMilestones}
      </div>
    )}

    {vendor.scope && vendor.scope.length > 0 && (
      <div style="margin-top: 8px;">
        <span style="font-size: 10.5px; color: var(--muted-text); text-transform: uppercase;">Scope:</span>
        <div style="display: flex; flex-wrap: wrap; gap: 4px; margin-top: 2px;">
          {vendor.scope.map(s => (
            <span style="font-size: 10px; background: #00000008; border: 1px solid #00000010; padding: 1px 6px; border-radius: 3px;">
              {s}
            </span>
          ))}
        </div>
      </div>
    )}

    <div class="card-meta" style="margin-top: 10px;">
      <strong>Target Buyers:</strong> {vendor.targetBuyers.join(', ')}
    </div>
  </div>

  <div class="card-footer">
    <div class="card-meta">
      <strong>Key Edge:</strong> {vendor.keyDifferentiator}
    </div>
    {vendor.website && (
      <div style="margin-top: 6px;">
        <a href={vendor.website} target="_blank" rel="noopener" class="service-link" style="font-size: 12px; font-weight: 500;">
          Explore vendor site &rarr;
        </a>
      </div>
    )}
  </div>
</div>
